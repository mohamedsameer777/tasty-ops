# Copy this file to .env and fill in real values. Never commit .env itself.

SECRET_KEY=change-me-to-a-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Set to True to skip Postgres setup and just use a local sqlite file
# while you're getting the API running for the first time.
USE_SQLITE=False

DB_NAME=tasty_ops
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Twilio WhatsApp — for the reorder agent's supplier messages.
# 1. Sign up free at https://console.twilio.com
# 2. Go to Messaging > Try it out > Send a WhatsApp message (sandbox)
# 3. Copy your Account SID and Auth Token from the console dashboard
# 4. TWILIO_WHATSAPP_FROM is the sandbox number shown there (e.g. +14155238886)
# 5. Each supplier must first send the sandbox's join code to that number
#    on WhatsApp once, to opt in (sandbox limitation — not needed once you
#    upgrade to a verified Twilio WhatsApp sender for production use).
# Leave all three blank to skip WhatsApp — the agent will just use email instead.
TWILIO_ACCOUNT_SID=AC9edaf1133030283210aac23d6169d970
TWILIO_AUTH_TOKEN=95716019fdf8f72be8af4044afc0e5dc
TWILIO_WHATSAPP_FROM=+14155238886